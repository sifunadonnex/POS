# Copy to backend/.env for local development only. Never commit real credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://pay_and_go:replace_me@127.0.0.1:5432/pay_and_go_dev
# disable is allowed only for loopback hosts. Remote connections require verify.
DATABASE_TLS=disable
DATABASE_POOL_MAX=5
# Generate a unique random secret; never use this placeholder.
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
# Browser origin: Vite forwards /api to Nest during local development.
BETTER_AUTH_URL=http://localhost:5173
# Keep false until the existing mailbox is configured privately. No test sends real email.
AUTH_EMAIL_ENABLED=false
SMTP_HOST=mail.example.test
# 465 uses implicit TLS; 587 requires STARTTLS. Certificate verification is mandatory.
SMTP_PORT=587
SMTP_USER=staff@example.test
SMTP_PASSWORD=replace_with_mailbox_app_password
SMTP_FROM=staff@example.test
