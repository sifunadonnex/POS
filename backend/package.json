{
  "name": "nest-typescript-starter",
  "version": "1.0.0",
  "description": "Nest TypeScript starter repository",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "hosting:install": "npx --yes pnpm@11.10.0 install --prod --frozen-lockfile --ignore-scripts",
    "hosting:diagnose": "node -e \"console.log('Node startup OK', process.version, process.platform, process.arch); console.log(JSON.stringify({memoryBytes:process.memoryUsage(),heapLimitBytes:require('node:v8').getHeapStatistics().heap_size_limit},null,2));\"",
    "hosting:migrate": "node dist/database/migrate.js up",
    "hosting:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-hosting.ps1",
    "db:migrate": "pnpm run build && node dist/database/migrate.js up",
    "auth:provision": "pnpm run build && node --env-file=.local/staff.env dist/identity/provision.js",
    "auth:setup": "node scripts/setup-local-auth.mjs",
    "db:rollback": "pnpm run build && node dist/database/migrate.js down",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:integration": "vitest run --config ./vitest.config.integration.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "1.7.4",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
